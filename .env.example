# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Node authentication API (server.js) ----
PORT=5000
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=UserAuth
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me
# Optional: restrict which site may call the API, e.g. https://your-site.example
# CORS_ORIGIN=*

# ---- Flask app (app.py) ----
FLASK_SECRET_KEY=change-me
FLASK_MYSQL_HOST=localhost
FLASK_MYSQL_USER=your_mysql_user
FLASK_MYSQL_PASSWORD=your_mysql_password
FLASK_MYSQL_DB=notes_db
FLASK_DEBUG=0
